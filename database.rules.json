{
  "rules": {
    "activeUsers": {
      ".read": true,
      ".write": "auth != null",
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "logoutSignals": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": true
      }
    },
    "statistics": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
